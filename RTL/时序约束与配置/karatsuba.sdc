#=============================================================================
# karatsuba.sdc -- FPGA (Gowin) 流程的时序约束
#
# 周期怎么来的:
#   Gowin 布局布线实测 Fmax = 45.183 MHz
#   留 10% 余量 -> 40.665 MHz -> 周期 24.591 ns
#
# 这个文件给 Gowin 综合和布局布线用。
# ASIC (OpenLane / sky130) 用另外两个文件: pnr.sdc 和 signoff.sdc,
# 它们写的是 52 ns (19.23 MHz)。原因看那两个文件的注释。
#=============================================================================

create_clock -name clk -period 24.591 -waveform {0.000 12.296} [get_ports {clk}]
